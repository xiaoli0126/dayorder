{
  "name": "dayorder",
  "version": "0.1.0",
  "private": true,
  "description": "日序 DayOrder — 本地时间轴作息与任务计划",
  "author": "DayOrder",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --require ./scripts/patch-net-use.cjs --require ./scripts/clean-electron-env.cjs ./node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node --require ./scripts/patch-net-use.cjs ./node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "node --require ./scripts/patch-net-use.cjs --require ./scripts/clean-electron-env.cjs ./node_modules/electron-vite/bin/electron-vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.node.json --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.web.json --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node --require ./scripts/patch-net-use.cjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --require ./scripts/patch-net-use.cjs ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node --require ./scripts/clean-electron-env.cjs ./node_modules/@playwright/test/cli.js test",
    "dist": "npm run build && node ./node_modules/electron-builder/cli.js --win",
    "dist:dir": "npm run build && node ./node_modules/electron-builder/cli.js --win --dir"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
